# ─── HRI Platform — Local Development Environment ─────────────────────────────
# Copy to .env before running docker-compose

# App
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-random-secret-in-production

# Database (SQLite for local, PostgreSQL for cloud)
DATABASE_URL=sqlite+aiosqlite:///./data/hri.db

# Ollama VLM
OLLAMA_BASE_URL=http://ollama:11434
VLM_MODEL=llava:13b

# Uploads
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=2048

# CORS
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── Cloud (prod only) ────────────────────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://hri_admin:<password>@<rds-endpoint>:5432/hri_platform
# AWS_REGION=eu-west-2
# AWS_S3_BUCKET=hri-platform-videos-prod-<suffix>
